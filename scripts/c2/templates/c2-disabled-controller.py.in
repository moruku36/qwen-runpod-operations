"""C2 approved loopback companion, disabled until separate secure handoff.

No journal/credential/key/provider/SSH loading, grant, worker or autostart.
This process only serves the accepted gateway's public health endpoint; all
authenticated routes deny while role credentials are absent.
"""
import datetime
import json
import os
from pathlib import Path
import sys
import threading

root=Path(__file__).resolve().parent
deployment_root=root.parent
if deployment_root != Path('@@REVIEWED_DEPLOYMENT_ROOT@@'):
    raise RuntimeError('canonical_deployment_path_mismatch')
sys.path.insert(0,str(root))
from qmc_runpod.production_gateway import ProductionGateway

def main():
    record=root/'disabled-controller.json'; stop=root/'stop-disabled-controller.flag'
    gateway=ProductionGateway(host=None,listen_approved=True)
    with gateway.serve(host='127.0.0.1',port=19180):
        with record.open('x',encoding='utf-8') as output:
            output.write(json.dumps({'pid':os.getpid(),'created_at_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),
            'deployment_root':str(deployment_root),'runtime_root':str(root),'log_root':str(deployment_root/'logs'),
            'credential_facility_opened':False,'mode':'C2_disabled_no_credentials','gateway':'127.0.0.1:19180','runpod_effects':False,
            'journal_opened':False,'tunnel_started':False},indent=2))
        while not stop.exists(): threading.Event().wait(.2)
    # Keep the public record after exit. An unknown concurrent update must never
    # be unlinked. Restart requires explicit maintenance review of retained state.

if __name__=='__main__': main()
